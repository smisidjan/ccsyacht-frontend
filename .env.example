NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.papertrail.ccsyacht.com/api
NEXT_PUBLIC_APP_NAME="Papertrail Marine by CCS Yacht"

# WebSocket (Reverb) Configuration - MUST match backend
# Get these values from your backend .env file
NEXT_PUBLIC_REVERB_APP_ID=your-app-id
NEXT_PUBLIC_REVERB_APP_KEY=your-app-key
NEXT_PUBLIC_REVERB_HOST=your-server-ip
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http