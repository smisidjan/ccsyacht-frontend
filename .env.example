# App
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Papertrail Marine by CCS Yacht"

# API (Laravel backend)
NEXT_PUBLIC_API_URL=https://api.papertrail.ccsyacht.com/api

# WebSocket (Reverb) — MUST match backend .env
NEXT_PUBLIC_REVERB_APP_KEY=papertrail-prod-key-2024
NEXT_PUBLIC_REVERB_HOST=167.235.135.241
NEXT_PUBLIC_REVERB_PORT=8080
# WARNING: HTTP WebSocket on HTTPS site causes mixed-content blocking!
# For production with HTTPS, you need:
# - NEXT_PUBLIC_REVERB_SCHEME=https
# - NEXT_PUBLIC_REVERB_PORT=443 (or configured TLS port)
# - Valid SSL cert on WebSocket server
NEXT_PUBLIC_REVERB_SCHEME=http