# App
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Papertrail Marine by CCS Yacht"

# API (Laravel backend)
NEXT_PUBLIC_API_URL=https://api.papertrail.ccsyacht.com/api

# WebSocket (Reverb) — Production with TLS
NEXT_PUBLIC_REVERB_APP_KEY=papertrail-prod-key-2024
NEXT_PUBLIC_REVERB_HOST=papertrail.ccsyacht.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# IMPORTANT: For WebSocket to work in production:
# 1. Nginx must proxy wss://papertrail.ccsyacht.com/reverb → http://localhost:8080
# 2. TLS certificate must be valid for papertrail.ccsyacht.com
# 3. Backend Reverb server runs on port 8080 (HTTP)